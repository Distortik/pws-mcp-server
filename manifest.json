{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/mcpb/main/schemas/mcpb-manifest-v0.3.schema.json",
  "manifest_version": "0.3",
  "name": "pro-wrestling-sim",
  "display_name": "Pro Wrestling Sim",
  "version": "0.4.0",
  "description": "Connect Claude Desktop to the save currently loaded in Pro Wrestling Sim.",
  "long_description": "Search and analyze the current Pro Wrestling Sim save, plan shows and storylines, review contracts, and perform validated game actions through the local PWS MCP bridge. The PWS MCP Server Workshop plugin must be enabled and a save must be loaded.",
  "author": {
    "name": "PWS MCP Server contributors",
    "url": "https://github.com/Distortik/pws-mcp-server"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Distortik/pws-mcp-server.git"
  },
  "homepage": "https://github.com/Distortik/pws-mcp-server",
  "documentation": "https://github.com/Distortik/pws-mcp-server#readme",
  "support": "https://github.com/Distortik/pws-mcp-server/issues",
  "server": {
    "type": "node",
    "entry_point": "mcpb-entry.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/mcpb-entry.js"
      ],
      "env": {}
    }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "keywords": [
    "pro-wrestling-sim",
    "wrestling",
    "booking",
    "simulation",
    "games"
  ],
  "license": "Apache-2.0",
  "compatibility": {
    "platforms": [
      "win32"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
